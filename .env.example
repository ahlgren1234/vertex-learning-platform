# Vertex — environment variables
# Canonical list. Copy to .env.local and fill in real values. Never commit .env.local.

# --- Clerk authentication -------------------------------------------------------
# Publishable key is safe for the browser. Secret key is server-only — never
# prefix it with NEXT_PUBLIC_ and never import it into a client component.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk's <SignIn />, <SignUp /> and redirects point.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
